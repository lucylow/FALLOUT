# GEMINI_API_KEY: Required for the AI Security Orchestrator (FALLOUT).
# Configure this via the Secrets panel in AI Studio.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# NODE_ENV: Set to 'production' for build or leave empty for dev.
NODE_ENV="development"

# JWT_SECRET: Secret key used to sign session tokens.
JWT_SECRET="super-secret-quantum-baseline-key-84"

# Stripe Configuration
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLIC_KEY=""
STRIPE_MONTHLY_PRICE_ID=""
STRIPE_YEARLY_PRICE_ID=""
STRIPE_ENTERPRISE_PRICE_ID=""
